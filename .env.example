# Server
PORT=3000
HOST=0.0.0.0

# Main LLM through an OpenAI-compatible endpoint. Keep the key server-side only.
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# n8n Agent bridge. Keep the webhook on the server side only.
N8N_AGENT_ENABLED=true
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/ich-agent
N8N_AGENT_TIMEOUT_MS=30000

# Optional shared secret. When set, also enable Header Auth in the n8n Webhook.
N8N_WEBHOOK_TOKEN=

# Guest AI rate limit: strict, normal, relaxed or off.
GUEST_AI_LIMIT=normal

# React end-to-end testing only.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000/
